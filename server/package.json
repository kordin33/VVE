    "helmet": "^8.1.0",
    "knex": "^3.1.0",
    "lib0": "^0.2.114",
    "mathjs": "^14.4.0",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^3.3.2",
    "openai": "^6.9.1",
    "pdf-parse": "^1.1.4",
    "pg": "^8.16.3",
    "sharp": "^0.34.5",
    "tesseract.js": "^6.0.1",
    "uuid": "^13.0.0",
    "ws": "^8.18.3",
